SECRET_KEY=change-this-in-production-to-a-secure-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# In production, specify a PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/siwolo_cms
DATABASE_URL=sqlite:///db.sqlite3

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Document Storage
STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE_MB=25

# Timezone
TIME_ZONE=Africa/Nairobi

# Email & Two-Factor Authentication Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=info@siwoloadvocates.com
EMAIL_TIMEOUT=10
REQUIRE_2FA=True
CHALLENGE_TTL_MINUTES=10
SETUP_CODE=your-secure-setup-code-here

