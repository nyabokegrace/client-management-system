# =============================================================================
# .dockerignore — Exclude files from the Docker build context
# Keeps the image small and avoids leaking secrets.
# =============================================================================

# ── Version control ────────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules
frontend/node_modules
frontend/.next          # built by the node-builder stage, not needed from host
frontend/out

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__
**/__pycache__
*.py[cod]
*.pyo
*.pyd
.Python
backend/staticfiles     # generated by collectstatic inside the container
backend/media           # user-uploaded files (should live on external storage)

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
*.env

# ── Database ──────────────────────────────────────────────────────────────────
db.sqlite3
*.sqlite3

# ── OS & editor artifacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── CI / test artifacts ───────────────────────────────────────────────────────
.github/
htmlcov/
.coverage
coverage.xml
*.log

# ── Docs (optional — remove if you want them inside the image) ────────────────
README.md
CHANGELOG.md
docs/
